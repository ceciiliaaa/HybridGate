# Copy this file to .env and fill in the keys you need.
# Nothing downstream of the frozen model outputs requires a key: the guardrails,
# the policies and the whole metrics chain run offline on the committed results.

# OpenAI, for the GPT-5 mini reviewer and the synthetic dataset builders
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# Anthropic, for the Claude Opus 4.6 reviewer
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# GitHub, optional. Raises the rate limit when collecting real pull requests
# for the dataset and for the external plausibility check.
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here
